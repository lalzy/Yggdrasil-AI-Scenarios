@page
@{
    ViewData["Title"] = "Setup";
    Layout = "Layout/_Main";
}

<script>
 async function redirectIfNotReady(){
     const [worldResponse, connectionResponse] = await Promise.all([
	 fetch("/api/world/all?count=1"),
	 fetch("/api/connection/all?count=1")
     ]);

     const worlds = await worldResponse.json();
     const connections = await connectionResponse.json();

     if(worlds.length === 0 && connections.length === 0){
	 window.location.href = "/Setup";
     }
 }

redirectIfNotReady();
</script>
